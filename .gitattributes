# Auto detect text files and perform LF normalization
* text=auto

# TypeScript files
*.ts text eol=lf
*.tsx text eol=lf

# JSON files
*.json text eol=lf

# Documentation
*.md text eol=lf

# Configuration files
*.yml text eol=lf
*.yaml text eol=lf
.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Scripts
*.sh text eol=lf
